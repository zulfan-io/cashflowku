    {
      "id": "voucher_pulsa",
      "kind": "widget",
      "enabled": false,
      "mount": "floating",
      "config": {}
    },
    {
      "id": "voucher_marketplace",
      "kind": "widget",
      "enabled": false,
      "mount": "floating",
      "config": {
        "brands": [
          "shopee",
          "blibli",
          "tiktok",
          "lazada"
        ]
      }
    }
  ],
  "campaigns": []
}
